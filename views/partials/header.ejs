<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script>
      document.documentElement.classList.add("js");
    </script>
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#f7f2e8" />
    <title>
      <%= typeof pageTitle !== 'undefined' ? pageTitle : 'Marginalia' %>
    </title>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/style.css" />
  </head>
  <body>
    <header
      class="masthead<%= typeof query !== 'undefined' && query ? ' is-searching' : '' %>"
    >
      <div class="masthead__inner">
        <a href="/" class="logotype">
          <svg class="logotype__mark" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M4 5.5A2.5 2.5 0 0 1 6.5 3H19a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H6.5A2.5 2.5 0 0 0 4 21.5V5.5Z"
            />
            <path d="M8 3v14" />
          </svg>
          <span>Marginalia</span>
        </a>

        <nav class="mastnav" aria-label="Primary">
          <a href="/" class="mastnav__link is-active">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path
                d="M4 19V6a2 2 0 0 1 2-2h9v15M4 19a2 2 0 0 0 2 2h11M4 19a2 2 0 0 1 2-2h9m4-9h1a1 1 0 0 1 1 1v13"
              />
            </svg>
            <span>Shelf</span>
          </a>
          <a href="/add" class="mastnav__link">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 5v14M5 12h14" />
            </svg>
            <span>Add book</span>
          </a>

          <div class="browse-slot">
            <button
              type="button"
              id="browseToggle"
              class="mastnav__link<%= typeof query !== 'undefined' && query ? ' is-active' : '' %>"
              aria-expanded="<%= typeof query !== 'undefined' && query ? 'true' : 'false' %>"
              aria-controls="inlineSearch"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="7" />
                <path d="m20 20-3.5-3.5" />
              </svg>
              <span>Browse</span>
            </button>

            <form
              class="inline-search"
              id="inlineSearch"
              action="/search"
              method="GET"
            >
              <button
                type="submit"
                class="inline-search__submit"
                aria-label="Search"
              >
                <svg
                  class="inline-search__icon"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <circle cx="11" cy="11" r="7" />
                  <path d="m20 20-3.5-3.5" />
                </svg>
              </button>
              <input
                type="search"
                id="searchInput"
                name="q"
                class="inline-search__input"
                placeholder="Search books by title&hellip;"
                aria-label="Search books by title"
                autocomplete="off"
                value="<%= typeof query !== 'undefined' ? query : '' %>"
              />
            </form>
          </div>

          <a href="/about" class="mastnav__link">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M12 11v5" />
              <path d="M12 8h.01" />
            </svg>
            <span>About</span>
          </a>
        </nav>
      </div>
    </header>

    <main></main>
  </body>
</html>
