<%- include("partials/header") %>

<section class="detail-section wrap">
  <a class="detail-back" href="/">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
    Back to the shelf
  </a>

  <article class="detail-card" data-genre="<%= book.genre %>">
    <img class="detail-cover" src="<%= book.cover %>" alt="Cover of <%= book.title %>" />

    <div class="detail-body">
      <span class="pill pill--theme"><%- themeIcon(book.genre) %><%= book.genre %></span>

      <h1 class="detail-title"><%= book.title %></h1>
      <p class="detail-author">by <%= book.author %></p>

      <div class="rating-line">
        <span class="rating" style="--rating: <%= book.rating %>;" aria-label="Rated <%= book.rating %> out of 5">
          <span class="stars-track">★★★★★</span>
          <span class="stars-fill">★★★★★</span>
        </span>
        <span class="rating-number"><%= book.rating.toFixed(1) %> / 5</span>
      </div>

      <p class="detail-date">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18"/></svg>
        Read <%= new Date(book.date_read).toLocaleDateString("en-US", { month: "long", year: "numeric" }) %>
      </p>

      <p class="detail-resume"><%= book.resume %></p>

      <div class="detail-actions">
        <a class="btn btn--ghost" href="/books/<%= book.id %>/edit">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
          Modify
        </a>

        <form class="detail-delete" action="/books/<%= book.id %>/delete" method="POST"
              onsubmit="return confirm('Remove this book from the shelf? This can&#39;t be undone.');">
          <button class="btn btn--danger" type="submit">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/></svg>
            Delete
          </button>
        </form>
      </div>
    </div>
  </article>
</section>

<%- include("partials/footer") %>
